// Behind a reverse proxy: Express's 'trust proxy' setting, so req.ip is the
// client's address. The OAuth endpoints rate-limit per req.ip; without this,
// all clients behind the proxy share one limit. Use the number of proxies (1)
// or their addresses, not true.
//exports.trust_proxy = 1;

// Login through an OpenID Connect provider (Google Workspace, Okta, Entra ID,
// Keycloak, ...) instead of users.txt. When set, the password login is gone:
// /login sends the browser to the provider, and only identities on the
// allowlist below get in. Register the app with the provider as a web
// application with the callback URL <your origin>/oidc/callback.
// Needs Node 20 or newer.
/*
exports.oidc = {
    issuer: 'https://accounts.example.com',
    client_id: '...',
    client_secret: '...',
    redirect_uri: 'https://dbb.example.com/oidc/callback',
    // the allowlist: any match admits; with none of these set, everyone is refused
    allow_emails: ['ann@example.com'],   // verified email, case-insensitive
    allow_groups: ['db-readers'],        // values of the groups claim
    allow_global_userfile: false,        // also the names in authenticate_userfile
    groups_claim: 'groups',              // default
};
*/

// Where OIDC / OAuth state is kept (registered MCP clients, pending logins,
// hashed codes and tokens). Relative to the working directory.
//exports.auth_db = 'auth.sqlite';

// MCP interface for agents: read-only database access at POST /mcp.
// Off unless a token or the oauth block is set.
// Enabling it needs Node 20 or newer (the rest of the app does not).
// Use TLS (a reverse proxy) if agents are not on localhost.
/*
exports.mcp = {
    // OAuth 2.1 for MCP clients: each user signs in through config.oidc (and
    // its allowlist) and the client gets its own revocable tokens. Needs
    // exports.oidc. public_url is the address clients reach this app at: an
    // origin only (https://host[:port]), no path; https unless localhost.
    oauth: {
        public_url: 'https://dbb.example.com',
        //access_ttl: 3600,       // seconds (default 1 hour)
        //refresh_ttl: 2592000,   // seconds (default 30 days)
    },
    // DEPRECATED: one shared static token ("Authorization: Bearer <token>"),
    // kept as an admin fallback; it works with or without oauth. A long
    // random string.
    //token: 'a long random string',
    // optional: rows returned per call (default 1000)
    //max_rows: 1000,
    // optional: statement timeout, milliseconds (default 30000)
    //timeout_ms: 30000,
};
*/

// For MCP, a database entry above can also carry credentials of a role that has
// only SELECT grants (and is not a superuser / has no FILE privilege); strongly
// recommended:
//   readonly_user: 'dbb_ro', readonly_password: '...',
