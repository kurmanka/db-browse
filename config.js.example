// store sessions in a file storate
var session = require('express-session');
var FileStore = require('session-file-store')(session);

exports.session_config = { 
    resave: true,
    saveUninitialized: true,
    secret: 'real sessions secret',
    store: new FileStore({
        path: "/var/dbb/sessions",   // storage path
        ttl:  600*3,                 // session time to live
    })
};

// list of users and theirs passwords in plain text,
// see users.txt.example
exports.authenticate_userfile = 'users.txt';

// memcached can be used for some caching
exports.cache = false;
exports.cache_memcached = 'localhost:11211';

// The row views (vertical, horizontal, one by one) can show just the start of
// long text and JSON values, so a page of records stays scannable; clicking a
// cell expands that one value. The "short values" switch in the fixed header
// flips it and the choice is remembered in a cookie. This is how many
// characters of a value the short form keeps; 0 switches the feature off and
// hides the switch.
//exports.compact_chars = 80;

// for postgres schema browsing
exports.pg_dump_path = 'pg_dump';

