extends page

block title

  | #{table}.#{column} values: 

block content

  if values && values[0]

    - var groupKeys = Object.keys(values[0])

    table.light
      tr
        each key in groupKeys
          th= key
          
      - var i = 0
      
      while i < values.length
        - var row = values[i]
        tr 
          each key, idx in groupKeys
            - var cell = row[key]
            if idx == groupKeys.length - 1
              //- the trailing count(*) is a number, not a value to drill into:
              //- linking it produced bogus URLs such as /db/table/count/1
              td.data= cell
            else
              //- an absolute, encoded link to the rows holding this value; the
              //- query-string filters the page was opened with come along
              td.data 
                a(href= valueUrls[i] class="subtle")= cell

        - i++
        
    div#columnCounter
      a #{values.length} rows
      |  · 
      a(href= moreUrl) show more

  else 
    p No data
