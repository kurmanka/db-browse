extends page

//- this is a common wrapper template for all row_detail_* pages.

block title
  | Results from #{table} 

block topnav2

  //- a direct child of body is a flex item, where float does not apply: the
  //- right alignment comes from the stylesheet instead
  p.nav2

      //- Compact ("short values") mode, issue 17. It belongs to the fixed header
      //- so it stays reachable while a page of tall records is scrolled. The
      //- choice lives in a cookie and static/js/row-compact.js applies it; the
      //- label is hidden until that script runs, because without it a switch
      //- would do nothing. Hidden entirely when config.compact_chars is 0.
      if compact_chars
        label.compact-toggle(hidden)
          input#compact(type="checkbox", checked=compact, data-limit=compact_chars,
                        title="Show only the start of long text and JSON values")
          |  short values
        |  · 

      - var i = 0
      - var size = Object.keys(table_views).length
      each label,code in table_views
        if links[code]
          a(href=links[code])= label
        else
          = label
        if ++i < size
          |  · 
      | &nbsp;

block content

  - var rows_total = values.length
  - var rows_show  = Math.min(rows_total, limit)

  //- which columns to show (issue 13); submits the current filters and the
  //- same path, with the selection as repeated ?cols= parameters
  if allColumns && allColumns.length > 1
    details.cols
      summary Columns: #{selectedColumns.length} of #{allColumns.length}
      form(method="get", action=req.path)
        each val, key in req.query
          if key != 'cols'
            input(type="hidden", name=key, value=val)
        each col in allColumns
          label.col
            input(type="checkbox", name="cols", value=col,
                  checked=selectedColumns.indexOf(col) !== -1)
            = col
        div
          button(type="submit") Apply

  //- As wide as the table it holds, so the summary line inside it has room to
  //- stay in view when the page is scrolled sideways; see .records in style.css
  .records
    block data

    p.total-rows Total rows: #{rows_total}, shown above: #{rows_show} 
      if links.more
        |  · 
        a(href= links.more) see more
      if links.all
        |  · 
        a(href= links.all) see all

  //- Compact mode first: it remembers each cell's full text before
  //- json-format.js turns a JSON cell into a tree (issue 17)
  script(src="/_/js/row-compact.js")

  //- turns each .json cell (views/inc/row_detail_value.pug) into a tree
  script(src="/_/js/json-format.js")
