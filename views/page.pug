//- the shared page layout; every other template extends it
html
  head
    //- the legacy parent.html declared this; without it a page whose
    //- Content-Type carries no charset is decoded as latin-1 and every
    //- non-ASCII character (the sort arrows, the em dash) turns to mojibake
    meta(charset="utf-8")
    title
      block title
    link(rel="stylesheet", href="/_/css/style.css")
    script(src="//ajax.googleapis.com/ajax/libs/jquery/2.0.0/jquery.min.js")
  body
    #topnav
      block topnav
      if authenticate
        a(href="/logout") Logout <<<
      else
        | &nbsp;

    block topnav2

    p.breadcrumbs
      if breadcrumbs
        each crumb,i in breadcrumbs
          if i > 0
            |  / 
          a(href="/" + crumb.u)= crumb.t
        |  / 

    #content
      h1 
        block title
      block content

    #footer
      | db-browse: 
      a(href='https://github.com/kurmanka/db-browse') source on github
      |  · 
      a(href='/_reset') reset
      |  · 
      a(href='/_exit') restart
