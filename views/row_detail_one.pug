extends row_detail_wrapper

block data

  - var i = 0 
  while i < rows_show
    p #{i+1}:
    table.light
      each data,key in values[i]

        tr
          th= key

          if data==null
            td.null null
          else 
            include inc/row_detail_value.pug

    //- rows of other tables that point at this record (issue 14)
    if referring_links && referring_links[i] && referring_links[i].length
      div.refs
        b Referenced by:
        each ref in referring_links[i]
          a.ref(href=ref.url)= ref.label
    - i++
